<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.uqori.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Uqori</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="com.uqori">
    <name>Uqori</name>
  </developer>
  <description>
    <p>
      Uqori is an open-source desktop app for coding agents with cross-project
      subagent delegation and orchestration. Work with your existing agent
      subscriptions, review code changes, and run commands in your projects.
    </p>
    <p>
      Connect from desktop, web, or mobile to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">uqori.desktop</launchable>
  <icon type="stock">uqori</icon>
  <provides>
    <binary>uqori</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://github.com/anilpixel/t3code</url>
  <url type="bugtracker">https://github.com/anilpixel/t3code/issues</url>
  <url type="vcs-browser">https://github.com/anilpixel/t3code</url>
</component>
